# No provider by default: no external ASR calls. Development uses Groq Free only.
ASR_PROVIDER=
GROQ_API_KEY=
# Set only after verifying the Groq organization is on Free (no paid upgrade).
GROQ_FREE_TIER_CONFIRMED=false
# Shared Redis REST database on a verified Free plan; never expose these to www.
ASR_REDIS_REST_URL=
ASR_REDIS_REST_TOKEN=
# Keep false. Google is preserved for future separately authorized use only.
ASR_ALLOW_PAID_PROVIDERS=false

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Default: service_account. Use wif explicitly for Vercel federation.
GOOGLE_AUTH_MODE=
GOOGLE_WIF_PROVIDER=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# VERCEL_ENV is supplied by Vercel; WIF permits preview/production only.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
SUPABASE_URL=
SUPABASE_ANON_KEY=
VOICE_ALLOWED_ORIGINS=
VOICE_ENABLE_ADAPTATION=

# Public HTTPS URL, also allow-list this exact URL in Supabase Auth.
BUDGETPRO_AUTH_REDIRECT_URL=https://budget-pro-lski.vercel.app/
