{
  "name": "budgetpro",
  "version": "1.3.0",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/voice/*.test.js",
    "dist:linux": "ELECTRON_BUILDER_CACHE=$PWD/.cache/electron-builder electron-builder --linux deb",
    "voice:test": "node --test tests/voice/*.test.js",
    "voice:test:api": "node scripts/voice-test-api.js",
    "voice:check": "node scripts/voice-check.js",
    "voice:smoke": "node scripts/voice-smoke.js",
    "voice:record-fixture": "node scripts/voice-record-fixture.js",
    "voice:benchmark:real": "node scripts/voice-benchmark-real.js",
    "voice:dev": "node scripts/voice-dev-server.js"
  },
  "keywords": [],
  "author": {
    "name": "BudgetPRO Team",
    "email": "support@budgetpro.app"
  },
  "license": "ISC",
  "description": "BudgetPRO personal finance manager",
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^7.6.5",
    "@capacitor/core": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capgo/capacitor-native-biometric": "^8.4.5",
    "@vercel/oidc": "4.0.5",
    "chart.js": "^4.4.0",
    "google-auth-library": "11.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pro.budget.app",
    "productName": "BudgetPRO",
    "asar": true,
    "files": [
      "desktop/**/*",
      "www/**/*",
      "package.json",
      "!www/**/*.backup",
      "!www/**/*.before_*"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "executableName": "budgetpro"
    }
  }
}
